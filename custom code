class Plugin extends AppPlugin {

    onLoad() {
        this.overlay = null;
        this.busy = false;

        this.ui.injectCSS(`
            .qc-backdrop {
                position: fixed; inset: 0; z-index: 99999;
                display: flex; align-items: flex-start; justify-content: center;
                padding-top: 18vh; background: rgba(0,0,0,0.35);
            }
            .qc-box {
                width: min(640px, 90vw);
                background: var(--panel-bg-color, Canvas);
                color: var(--text-default, CanvasText);
                border: 1px solid rgba(128,128,128,0.35);
                border-radius: 10px;
                box-shadow: 0 12px 40px rgba(0,0,0,0.4);
                padding: 12px;
            }
            .qc-input {
                width: 100%; min-height: 84px; resize: vertical; box-sizing: border-box;
                background: transparent; color: inherit; font: inherit;
                border: none; outline: none; padding: 4px;
            }
            .qc-hint { font-size: 11px; opacity: 0.55; padding: 6px 4px 0; }
        `);

        this.command = this.ui.addCommandPaletteCommand({
            label: "Quick Capture",
            icon: "ti-bolt",
            onSelected: () => this.openCapture(),
        });
    }

    onUnload() {
        this.closeCapture();
        if (this.command) this.command.remove();
    }

    // ---------------------------------------------------------------- UI

    openCapture() {
        if (this.overlay) return;

        const backdrop = document.createElement("div");
        backdrop.className = "qc-backdrop";
        backdrop.innerHTML = `
            <div class="qc-box">
                <textarea class="qc-input" placeholder="Capture to today's journal…" spellcheck="true"></textarea>
                <div class="qc-hint">Enter to save · Shift+Enter for new line · Esc to cancel · [] = task · @date</div>
            </div>`;
        const input = backdrop.querySelector("textarea");

        backdrop.addEventListener("mousedown", (e) => {
            if (e.target === backdrop) this.closeCapture();
        });
        input.addEventListener("keydown", (e) => {
            e.stopPropagation(); // keep Thymer's own shortcuts out of the way
            if (e.key === "Escape") {
                e.preventDefault();
                this.closeCapture();
            } else if (e.key === "Enter" && !e.shiftKey && !e.isComposing) {
                e.preventDefault();
                this.submit(input.value);
            }
        });

        document.body.appendChild(backdrop);
        this.overlay = backdrop;
        // Delay focus so the command palette finishes closing first
        setTimeout(() => input.focus(), 50);
    }

    closeCapture() {
        if (this.overlay) {
            this.overlay.remove();
            this.overlay = null;
        }
        this.busy = false;
    }

    toast(title, message) {
        this.ui.addToaster({ title, message, dismissible: true, autoDestroyTime: 2500 });
    }

    // ---------------------------------------------------------------- Capture

    async submit(raw) {
        const text = (raw || "").trim();
        if (!text) return this.closeCapture();
        if (this.busy) return;
        this.busy = true;

        try {
            const record = await this.getTodayJournalRecord();
            if (!record) {
                this.busy = false;
                this.toast("Quick Capture", "Couldn't find a Journal page. Is the Journal plugin enabled?");
                return;
            }

            // Append after the last top-level item on the page
            const existing = await record.getLineItems(false);
            const top = existing.filter((i) => !i.parent_guid || i.parent_guid === record.guid);
            let last = top.length ? top[top.length - 1] : null;

            const lines = text.split("\n").map((l) => l.trim()).filter(Boolean);
            for (const line of lines) {
                const parsed = this.parseLine(line);
                const item = await record.createLineItem(null, last, parsed.type, parsed.segments, null);
                if (item) {
                    last = item;
                    if (parsed.done) await item.setTaskStatus("done");
                }
            }

            this.closeCapture();
            this.toast("Captured", lines.length > 1 ? `${lines.length} lines added to today` : "Added to today");
        } catch (err) {
            console.error("[Quick Capture]", err);
            this.busy = false;
            this.toast("Quick Capture failed", String(err && err.message ? err.message : err));
        }
    }

    async getTodayJournalRecord() {
        const collections = await this.data.getAllCollections();
        const journal = collections.find((c) => c.isJournalPlugin());
        if (!journal) return null;

        const users = this.data.getActiveUsers();
        if (!users.length) return null;

        // The SDK has no "current user" call. Optionally set
        // "custom": { "user_email": "you@example.com" } in this plugin's config
        // if you're in a multi-user workspace.
        const cfg = this.getConfiguration();
        const email = cfg && cfg.custom && cfg.custom.user_email;
        const user = (email && users.find((u) => u.getEmail() === email)) || users[0];

        return journal.getJournalRecord(user, new DateTime());
    }

    // ---------------------------------------------------------------- Parsing

    parseLine(line) {
        let type = "text";
        let done = false;
        let body = line;

        // "[] thing" or "[ ] thing" -> task; "[x] thing" -> completed task
        const m = body.match(/^\[\s?([xX]?)\s?\]\s*/);
        if (m) {
            type = "task";
            done = m[1] !== "";
            body = body.slice(m[0].length);
        }

        return { type, done, segments: this.buildSegments(body) };
    }

    /**
     * Turns text into segments. "@<date expression>" becomes a datetime segment.
     * Tries the longest run of words first (max 6) so "@next week" wins over "@next".
     */
    buildSegments(text) {
        const segments = [];
        let buffer = "";
        let i = 0;

        while (i < text.length) {
            const atStart = text[i] === "@" && (i === 0 || /\s/.test(text[i - 1]));
            if (atStart) {
                const hit = this.tryParseDate(text, i + 1);
                if (hit) {
                    this.pushText(segments, buffer);
                    buffer = "";
                    segments.push({ type: "datetime", text: hit.value });
                    i = hit.end;
                    continue;
                }
            }
            buffer += text[i];
            i++;
        }
        this.pushText(segments, buffer);

        if (!segments.length) segments.push({ type: "text", text: "" });
        return segments;
    }

    tryParseDate(text, start) {
        const rest = text.slice(start);
        const wordEnds = [];
        const re = /\S+/g;
        let w;
        while ((w = re.exec(rest)) && wordEnds.length < 6) {
            wordEnds.push(w.index + w[0].length);
        }

        for (let n = wordEnds.length; n >= 1; n--) {
            let candidate = rest.slice(0, wordEnds[n - 1]);
            const trailing = (candidate.match(/[.,;:!?)]+$/) || [""])[0]; // leave punctuation as text
            candidate = candidate.slice(0, candidate.length - trailing.length);
            if (!candidate) continue;

            const dt = DateTime.parseDateTimeString(candidate);
            if (dt) {
                return { value: dt.value(), end: start + candidate.length };
            }
        }
        return null;
    }

    // Splits plain text into text / link / hashtag segments
    pushText(segments, str) {
        if (!str) return;
        const parts = str.split(/(https?:\/\/[^\s]+|(?:^|(?<=\s))#[A-Za-z][\w-]*)/g);
        for (const part of parts) {
            if (!part) continue;
            if (/^https?:\/\//.test(part)) segments.push({ type: "link", text: part });
            else if (/^#[A-Za-z]/.test(part)) segments.push({ type: "hashtag", text: part });
            else segments.push({ type: "text", text: part });
        }
    }
}
