const DIALOG_CSS = `
    .quick-capture-overlay {
        position: fixed;
        top: 0; left: 0; right: 0; bottom: 0;
        background: rgba(0, 0, 0, 0.5);
        display: flex;
        align-items: center;
        justify-content: center;
        z-index: 10000;
        backdrop-filter: blur(8px);
    }
    .quick-capture-dialog {
        background: #1e1e1e;
        border: 1px solid #333;
        border-radius: 10px;
        padding: 24px;
        width: 480px;
        max-width: 90vw;
        box-shadow: 0 16px 48px rgba(0, 0, 0, 0.6);
    }
    .quick-capture-title {
        font-size: 13px;
        font-weight: 600;
        color: #888;
        text-transform: uppercase;
        letter-spacing: 0.08em;
        margin-bottom: 12px;
        display: flex;
        align-items: center;
        gap: 7px;
    }
    .quick-capture-title .ti {
        color: #aaa;
        font-size: 14px;
    }
    .quick-capture-textarea {
        width: 100%;
        height: 110px;
        background: #141414;
        border: 1px solid #2e2e2e;
        border-radius: 6px;
        padding: 10px 12px;
        font-family: var(--font-family);
        font-size: 14px;
        color: #e8e8e8;
        resize: none;
        margin-bottom: 8px;
        transition: border-color 0.15s ease;
        line-height: 1.6;
        box-sizing: border-box;
    }
    .quick-capture-textarea:focus {
        outline: none;
        border-color: #555;
    }
    .quick-capture-textarea::placeholder {
        color: #444;
    }
    .quick-capture-hint {
        font-size: 11px;
        color: #444;
        margin-bottom: 16px;
    }
    .quick-capture-buttons {
        display: flex;
        gap: 8px;
        justify-content: flex-end;
    }
    .quick-capture-btn {
        padding: 7px 16px;
        border-radius: 6px;
        font-size: 13px;
        font-weight: 500;
        cursor: pointer;
        transition: all 0.15s ease;
        font-family: var(--font-family);
        border: 1px solid transparent;
    }
    .quick-capture-btn-primary {
        background: #e8e8e8;
        color: #111;
        border-color: #e8e8e8;
    }
    .quick-capture-btn-primary:hover {
        background: #fff;
        border-color: #fff;
    }
    .quick-capture-btn-secondary {
        background: transparent;
        color: #666;
        border-color: #2e2e2e;
    }
    .quick-capture-btn-secondary:hover {
        background: #2a2a2a;
        color: #aaa;
    }
`;

class Plugin extends AppPlugin {

    async onLoad() {
        this.ui.injectCSS(DIALOG_CSS);

        this.captureCommand = this.ui.addCommandPaletteCommand({
            label: 'Quick Capture',
            icon: 'bolt',
            onSelected: () => this.openCaptureDialog()
        });
    }

    onUnload() {
        this.captureCommand?.remove();
    }

    async openCaptureDialog() {
        const overlay = document.createElement('div');
        overlay.className = 'quick-capture-overlay';
        overlay.innerHTML = `
            <div class="quick-capture-dialog">
                <div class="quick-capture-title">
                    <span class="ti ti-bolt"></span>
                    Quick Capture
                </div>
                <textarea
                    class="quick-capture-textarea"
                    placeholder="Type your thought here... (start with [ ] for a task)"></textarea>
                <div class="quick-capture-hint">Enter to capture · Shift+Enter for new line · Esc to cancel</div>
                <div class="quick-capture-buttons">
                    <button class="quick-capture-btn quick-capture-btn-secondary" data-action="cancel">Cancel</button>
                    <button class="quick-capture-btn quick-capture-btn-primary" data-action="capture">Capture</button>
                </div>
            </div>
        `;
        document.body.appendChild(overlay);

        const textarea = overlay.querySelector('.quick-capture-textarea');
        setTimeout(() => textarea.focus(), 50);

        const close = () => overlay.remove();

        const capture = async () => {
            const text = textarea.value.trim();
            if (!text) return;
            close();
            await this.captureToJournal(text);
        };

        overlay.querySelector('[data-action="capture"]').addEventListener('click', capture);
        overlay.querySelector('[data-action="cancel"]').addEventListener('click', close);
        overlay.addEventListener('click', (e) => { if (e.target === overlay) close(); });

        textarea.addEventListener('keydown', (e) => {
            if (e.key === 'Escape') { e.preventDefault(); close(); }
            if (e.key === 'Enter' && !e.shiftKey) { e.preventDefault(); capture(); }
        });
    }

    async captureToJournal(text) {
        try {
            const journal = await this.getTodayJournal();

            if (!journal) {
                this.ui.addToaster({
                    title: 'Quick Capture',
                    message: 'No Journal found for today. Make sure a Journal collection exists.',
                    dismissible: true,
                    autoDestroyTime: 4000,
                });
                return;
            }

            const lineItems = await journal.getLineItems();
            const lastTopLevel = lineItems.filter(i => i.parent_guid === journal.guid).at(-1) ?? null;

            const isTask = text.startsWith('[ ]');
            const cleanText = isTask ? text.slice(3).trim() : text;

            if (isTask) {
                const newItem = await journal.createLineItem(null, lastTopLevel, 'task', null, null);
                if (newItem) {
                    await newItem.setTaskStatus('none');
                    await newItem.setSegments([
                        { type: 'text', text: cleanText },
                    ]);
                }
            } else {
                const now = new Date();
                const timestamp = now.toLocaleTimeString([], { hour: '2-digit', minute: '2-digit', hour12: false });
                const newItem = await journal.createLineItem(null, lastTopLevel, 'text', null, null);
                if (newItem) {
                    await newItem.setSegments([
                        { type: 'bold', text: timestamp },
                        { type: 'text', text: `  ${cleanText}` },
                    ]);
                }
            }

            this.ui.addToaster({
                title: 'Quick Capture',
                message: '✓ Added to today\'s journal',
                dismissible: false,
                autoDestroyTime: 2000,
            });

        } catch (error) {
            console.error('[Quick Capture] Error:', error);
            this.ui.addToaster({
                title: 'Quick Capture',
                message: `Error: ${error.message}`,
                dismissible: true,
                autoDestroyTime: 4000,
            });
        }
    }

    async getTodayJournal() {
        const collections = await this.data.getAllCollections();
        const journalCollection = collections.find(c => c.isJournalPlugin());
        if (!journalCollection) return null;

        const user = this.data.getActiveUsers()[0];
        if (!user) return null;

        return journalCollection.getJournalRecord(user, DateTime.parseDateTimeString('today'));
    }
}
